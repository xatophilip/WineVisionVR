+static NTSTATUS
+_MTLDevice_newBuffer32(void *obj) {
+  struct unixcall_mtldevice_newbuffer *params = obj;
+  void *guest_info = params->info.ptr;
+  struct WMTBufferInfo *info = wow_in(guest_info);
+  if (!info) { params->ret = 0; return STATUS_INVALID_PARAMETER; }
+  void *guest_memory = info->memory.ptr;
+  info->memory.ptr = wow_in(guest_memory);
+  params->info.ptr = info;
+  NTSTATUS status = _MTLDevice_newBuffer(obj);
+  if (guest_memory && info->memory.ptr) info->memory.ptr = guest_memory;
+  /* A newly allocated native pointer occupies all eight bytes of the existing
+   * WMTMemoryPointer; i386 get_accessible_or_null() correctly rejects CPU use.
+   * Dynamic/staging allocations already provide guest-owned backing. */
+  params->info.ptr = guest_info;
+  return status;
+}
