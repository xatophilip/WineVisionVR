+/* Only the optional iOS backend consumes this shared host table. Resolve and
+ * translate both PE call targets before reaching here; never call a PE export
+ * directly from Mach-O or truncate the host address into a guest ULONG. */
+static void init_ios_mono_bridge(void)
+{
+    ULONG64 bridge = 0;
+    NTSTATUS status;
+
+    if (!pBTCpuIosSetMonoBridge || !p__wine_ios_get_mono_bridge) return;
+    status = p__wine_ios_get_mono_bridge( &bridge );
+    if (!status && bridge)
+    {
+        pBTCpuIosSetMonoBridge( bridge );
+        TRACE( "handed Mono bridge to WoW64 CPU backend\n" );
+    }
+    else ERR( "Mono bridge unavailable (status %lx, ptr %s)\n",
+              status, bridge ? "set" : "NULL" );
+}
