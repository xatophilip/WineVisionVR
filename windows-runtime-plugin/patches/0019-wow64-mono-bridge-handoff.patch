+/* Optional native-PE accessor for the WoW64 CPU backend's Mono alias table.
+ * Keep the existing Unix-call ordinal and all Mach-O calls behind ntdll. */
+NTSTATUS WINAPI __wine_ios_get_mono_bridge( ULONG64 *bridge )
+{
+    if (!bridge) return STATUS_INVALID_PARAMETER;
+    *bridge = 0;
+    return WINE_UNIX_CALL( unix_ios_mono_bridge_ptr, bridge );
+}
 
 
