--- a/wine/dlls/win32u/win32u_private.h
+++ b/wine/dlls/win32u/win32u_private.h
@@ -378,17 +378,17 @@
  * upstream's code paths after one load of this flag. */
 extern BOOL win32u_wow_session;
 
-/* Publish the GDI shared handle table into the calling WoW64 pseudo-process's
- * PEB, mapping a second view of the table inside its guest window first
- * (gdiobj.c).  64-bit threads never get here: they keep upstream's single
- * publication by init_gdi_shared().  The __thread flag makes the steady-state
- * check one load and one compare. */
+/* Each embedded pseudo-process has its own PEB, even when native user/GDI
+ * initialization has already run in another process. Publish the shared table
+ * for 64-bit children too. WoW64 publication still requires a section-backed
+ * table so that gdiobj.c can map it into the child's guest window. */
 extern __thread void *win32u_gdi_published_peb;
 extern void win32u_gdi_publish_shared(void);
 static inline void win32u_gdi_check_publish(void)
 {
-    if (win32u_wow_session && NtCurrentTeb()->WowTebOffset &&
-        win32u_gdi_published_peb != NtCurrentTeb()->Peb)
+    TEB *teb = NtCurrentTeb();
+    if ((!teb->WowTebOffset || win32u_wow_session) &&
+        (win32u_gdi_published_peb != teb->Peb || !teb->Peb->GdiSharedHandleTable))
         win32u_gdi_publish_shared();
 }
 #else
--- a/build/win32u-unix/class_ios.c
+++ b/build/win32u-unix/class_ios.c
@@ -429,6 +429,8 @@
     pthread_mutex_unlock( &winproc_lock );
 
     pthread_once( &init_once, init_user );
+    /* init_user is native-global; this publication is per guest process. */
+    win32u_gdi_check_publish();
     return STATUS_SUCCESS;
 }
 
