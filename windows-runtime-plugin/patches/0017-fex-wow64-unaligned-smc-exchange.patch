# Complete the observed WoW64 unaligned32 SWP through existing FEX atomic
# recovery after SMC accepts an anonymous executable-page write. Recognized
# failures retain the normal guest-context reconstruction and JIT cleanup.
--- a/FEX/Source/Windows/WOW64/Module.cpp
+++ b/FEX/Source/Windows/WOW64/Module.cpp
@@ -715,6 +715,52 @@
   Context->Pc += Result.value_or(0);
   return Result.has_value();
 }
+
