+#ifdef FEX_IOS_HOST
+extern "C" uint64_t IosMonoResolveRW(uint64_t HostAddr, uint64_t Size);
+
+// A protected anonymous Mono page can fault as AV before the CPU reports the
+// alignment fault. The normal SMC retry leaves this unaligned SWP unchanged.
+// nullopt: outside this fix; false: recognized access cannot safely complete.
+std::optional<bool> HandleIosSmcUnalignedExchange(TLS TLS, CONTEXT* Context, uint64_t FaultAddress) {
+  auto Thread = TLS.ThreadState();
+  if (!Thread || !Thread->CTX->IsAddressInCodeBuffer(Thread, Context->Pc)) {
+    return std::nullopt;
+  }
+  const uint32_t Instr = *reinterpret_cast<const uint32_t*>(Context->Pc);
+  // Only the observed 32-bit SWP{A}{L}; never route plain/byte stores through
+  // the unaligned backpatcher, which may require reserved neighboring slots.
+  if ((Instr & 0x3F20FC00u) != 0x38208000u || (Instr >> 30) != 2) {
+    return std::nullopt;
+  }
+  const uint32_t Rn = (Instr >> 5) & 31;
+  if (Rn == 31) {
+    return std::nullopt;
+  }
+  const uint64_t Address = Context->X[Rn];
+  if (!(Address & 3)) {
+    return std::nullopt;
+  }
+  // DoCAS32 uses an aligned 64/128-bit CAS when the whole access fits in
+  // sixteen bytes. Do not opt into its split-region fallback here.
+  if (Address != FaultAddress || (Address & 15) > 12) {
+    return false;
+  }
+  const uint64_t Footprint = Address & ~uint64_t{15};
+  if (Footprint > UINT64_MAX - 16) {
+    return false;
+  }
+  const uint64_t Writable = IosMonoResolveRW(Footprint, 16);
+  if (!Writable || (Writable & 15)) {
+    return false;
+  }
+  const uint64_t PreviousPc = Context->Pc;
+  // Existing FEX recovery resolves the same live RX->RW alias and preserves
+  // atomic exchange using aligned CAS; never emulate with a read/write pair.
+  return HandleUnalignedAccess(TLS, Context) && Context->Pc == PreviousPc + 4;
+}
+#endif
 
