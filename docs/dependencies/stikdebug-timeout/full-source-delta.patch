+#!/usr/bin/env python3
+"""Exercise the real bounded TCP probe using owned localhost listeners and an optional reserved-address timeout."""
+import argparse
+from pathlib import Path
+import subprocess
+
+root = Path(__file__).resolve().parents[1]
+parser = argparse.ArgumentParser(description=__doc__)
+parser.add_argument('--build', required=True, type=Path)
+args = parser.parse_args()
+args.build.mkdir(parents=True, exist_ok=True)
+unit = args.build / 'main.swift'
+unit.write_text(r'''
+import Foundation
+import Darwin
+extension UserDefaults {
+    enum Keys { static let targetDevicePort = "testTargetPort" }
+}
+enum DeviceConnectionContext {
+    static let defaultTargetIPAddress = "10.7.0.1"
+    static let targetIPAddress = defaultTargetIPAddress
+}
+struct RemotePairingService {
+    var port: UInt16; var host: String; var interfaceName: String?; var isIPv6: Bool; var scopeID: UInt32
+}
+enum RemotePairingBrowser { static func discover() -> [RemotePairingService] { [] } }
+func check(_ condition: @autoclosure () -> Bool, _ message: String) {
+    if !condition() { fatalError(message) }
+}
+func listener(backlog: Int32 = 8) -> (Int32, UInt16) {
+    let fd = socket(AF_INET, SOCK_STREAM, IPPROTO_TCP)
+    check(fd >= 0, "socket listener")
+    var address = sockaddr_in()
+    address.sin_len = UInt8(MemoryLayout<sockaddr_in>.size)
+    address.sin_family = sa_family_t(AF_INET)
+    address.sin_addr.s_addr = inet_addr("127.0.0.1")
+    let bound = withUnsafePointer(to: &address) { pointer in
+        pointer.withMemoryRebound(to: sockaddr.self, capacity: 1) {
+            Darwin.bind(fd, $0, socklen_t(MemoryLayout<sockaddr_in>.size))
+        }
+    }
+    check(bound == 0 && Darwin.listen(fd, backlog) == 0, "bind/listen")
+    var length = socklen_t(MemoryLayout<sockaddr_in>.size)
+    let named = withUnsafeMutablePointer(to: &address) { pointer in
+        pointer.withMemoryRebound(to: sockaddr.self, capacity: 1) { getsockname(fd, $0, &length) }
+    }
+    check(named == 0, "getsockname")
+    return (fd, UInt16(bigEndian: address.sin_port))
+}
+func target(_ port: UInt16) -> TunnelTarget {
+    TunnelTarget(source: .loopback, host: "127.0.0.1", port: port,
+                 interfaceName: nil, family: AF_INET, scopeID: 0)
+}
+let (refusedFD, refusedPort) = listener()
+close(refusedFD)
+let refused = TunnelTargetResolver.probe(target(refusedPort), timeout: 0.2)
+if case .refused = refused {} else { fatalError("Closed localhost port: \(refused.summary)") }
+check(!refused.shouldAttemptPairVerify, "Refused target must skip pairing FFI")
+print("PASS: refused localhost target skips pair-verify")
+
+let (openFD, openPort) = listener()
+let openDone = DispatchSemaphore(value: 0)
+DispatchQueue.global().async {
+    let client = accept(openFD, nil, nil)
+    if client >= 0 { usleep(350_000); close(client) }
+    openDone.signal()
+}
+let openStart = ProcessInfo.processInfo.systemUptime
+let opened = TunnelTargetResolver.probe(target(openPort), timeout: 0.15)
+if case .open = opened {} else { fatalError("Held localhost listener: \(opened.summary)") }
+let openDuration = ProcessInfo.processInfo.systemUptime - openStart
+check(openDuration < 0.8 && opened.shouldAttemptPairVerify, "Hold/read budget and pairing eligibility")
+check(openDone.wait(timeout: .now() + 1) == .success, "Open listener cleanup")
+close(openFD)
+print("PASS: held localhost listener remains open within shared deadline")
+
+let (resetFD, resetPort) = listener()
+let resetDone = DispatchSemaphore(value: 0)
+DispatchQueue.global().async {
+    let client = accept(resetFD, nil, nil)
+    if client >= 0 { close(client) }
+    resetDone.signal()
+}
+let reset = TunnelTargetResolver.probe(target(resetPort), timeout: 0.2)
+if case .reset = reset {} else { fatalError("Immediate-close localhost listener: \(reset.summary)") }
+check(reset.shouldAttemptPairVerify, "A protocol listener's empty-probe reset may still permit pair-verify")
+check(resetDone.wait(timeout: .now() + 1) == .success, "Reset listener cleanup")
+close(resetFD)
+print("PASS: immediate EOF/reset classified without disabling real pair-verify")
+
+// The reserved benchmark address is optional: a host route may reject it
+// immediately. A pending TCP connect must obey the same monotonic deadline.
+let blackhole = TunnelTarget(source: .loopback, host: "198.18.0.1", port: 49152,
+                            interfaceName: nil, family: AF_INET, scopeID: 0)
+let timeoutStart = ProcessInfo.processInfo.systemUptime
+let timedOut = TunnelTargetResolver.probe(blackhole, timeout: 0.2)
+let duration = ProcessInfo.processInfo.systemUptime - timeoutStart
+if case .timedOut = timedOut {
+    check(duration >= 0.15 && duration < 0.8, "Pending connect exceeded deadline: \(duration)s")
+    print("PASS: real pending connect timed out in \(duration)s")
+} else {
+    print("SKIP: reserved-address pending connect unavailable: \(timedOut.summary)")
+}
+check(!TunnelTargetResolver.ProbeResult.timedOut.shouldAttemptPairVerify, "Timed-out target must never enter another blocking FFI connect")
+check(!TunnelTargetResolver.ProbeResult.unreachable("test").shouldAttemptPairVerify, "Unreachable target skips FFI")
+print("PASS: timed-out/unreachable targets skip pair-verify")
+''')
+subprocess.run(['xcrun', 'swiftc', str(root / 'StikDebug/Device/TunnelTargetResolver.swift'),
+                str(unit), '-o', str(args.build / 'probe-tests')], check=True)
+subprocess.run([str(args.build / 'probe-tests')], check=True, timeout=10)
+source = (root / 'StikDebug/Device/JITEnableContext.swift').read_text()
+loop = source.split('for target in ordered {', 1)[1].split('Self.lastGoodTarget = nil', 1)[0]
+assert loop.index('guard reachability.shouldAttemptPairVerify') < loop.index('return try createTunnel(hostname: hostname, target: target)')
+print('PASS: production candidate loop gates the FFI with the tested reachability policy')
